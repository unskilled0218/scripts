#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: dup [-f file] [arguments...]
Run docker compose -f <file> up -d with any remaining arguments.
The file defaults to ./docker-compose.yml. Use -f/--file before up arguments.
Example: dup -f ./docker-compose.yml --build web
Relative paths inside the Compose file resolve from its directory.
HELP
}

file='./docker-compose.yml'
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -f|--file)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        printf 'Option %s requires a file.\n' "$1" >&2
        exit 2
      fi
      file="$2"
      shift 2
      ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [[ ! -f "$file" ]]; then
  printf 'Compose file not found: %s\n' "$file" >&2
  exit 1
fi
if ! command -v docker >/dev/null 2>&1; then
  printf 'Docker is required.\n' >&2
  exit 1
fi
exec docker compose -f "$file" up -d "$@"
