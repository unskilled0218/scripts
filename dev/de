#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: de [-f file] [-T] [--] service [command...]
Run a command in a running Compose service. The default command is sh.
The file defaults to ./docker-compose.yml. Use -T for non-interactive input.
Example: de -f ./other.yml -T web env
Use Compose service names, not container names.
For a one-off container, use docker compose run --rm instead.
HELP
}

file='./docker-compose.yml'
options=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -f)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'Option -f requires a file.\n' >&2
        exit 2
      fi
      file="$2"
      shift 2
      ;;
    -T) options+=('-T'); shift ;;
    --) shift; break ;;
    -*) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
done
if [[ $# -eq 0 || -z "$1" ]]; then
  usage >&2
  exit 2
fi
service="$1"
shift
if [[ $# -eq 0 ]]; then
  set -- sh
fi
if [[ ! -f "$file" ]]; then
  printf 'Compose file not found: %s\n' "$file" >&2
  exit 1
fi
if ! command -v docker >/dev/null 2>&1; then
  printf 'Docker is required.\n' >&2
  exit 1
fi
exec docker compose -f "$file" exec "${options[@]}" -- "$service" "$@"
