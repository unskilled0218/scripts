#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: de [-f file]
Open interactive Bash in the running container from a Compose file.
The file defaults to ./docker-compose.yml. Bash must exist in the container.
Exactly one running container must exist for the Compose project.
Examples:
  de
  de -f ./other.yml
HELP
}

file='./docker-compose.yml'
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -f|--file)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        printf 'Option %s requires a file.\n' "$1" >&2
        exit 2
      fi
      file="$2"
      shift 2
      ;;
    -*) printf 'Unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if ! command -v docker >/dev/null 2>&1; then
  printf 'Docker is required.\n' >&2
  exit 1
fi
if [[ ! -f "$file" ]]; then
  printf 'Compose file not found: %s\n' "$file" >&2
  exit 1
fi
running=$(docker compose -f "$file" ps -q --status running)
if [[ -z "$running" ]]; then
  printf 'No running Compose containers found.\n' >&2
  exit 1
fi
mapfile -t containers <<< "$running"
if [[ ${#containers[@]} -ne 1 ]]; then
  printf 'Expected exactly one running Compose container; found %s.\n' "${#containers[@]}" >&2
  exit 2
fi
exec docker exec -it "${containers[0]}" bash
