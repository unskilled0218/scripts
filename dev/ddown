#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: ddown [-f file | -p name] [arguments...]
Run docker compose -f <file> down with any remaining arguments.
The file defaults to ./docker-compose.yml. Use -f/--file or -p before down arguments.
-p selects ./docker-compose.<name>.yml, not a Compose project name.
Example: ddown -f ./docker-compose.yml --remove-orphans
Example: ddown -p dev
Relative paths inside the Compose file resolve from its directory.
HELP
}

file='./docker-compose.yml'
file_set=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -f|--file)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
        printf 'Option %s requires a file.\n' "$1" >&2
        exit 2
      fi
      if [[ "$file_set" == true ]]; then
        printf 'Use only one of -f/--file or -p.\n' >&2
        exit 2
      fi
      file="$2"
      file_set=true
      shift 2
      ;;
    -p)
      if [[ $# -lt 2 || -z "$2" || "$2" == -* || "$2" == */* ]]; then
        printf 'Option %s requires a name without slashes.\n' "$1" >&2
        exit 2
      fi
      if [[ "$file_set" == true ]]; then
        printf 'Use only one of -f/--file or -p.\n' >&2
        exit 2
      fi
      file="./docker-compose.$2.yml"
      file_set=true
      shift 2
      ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [[ ! -f "$file" ]]; then
  printf 'Compose file not found: %s\n' "$file" >&2
  exit 1
fi
if ! command -v docker >/dev/null 2>&1; then
  printf 'Docker is required.\n' >&2
  exit 1
fi
exec docker compose -f "$file" down "$@"
